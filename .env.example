# Required: used for embeddings (retrieval) and for generation.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key"

# Optional overrides
# OPENROUTER_MODEL="openai/gpt-oss-120b"
# EMBEDDING_MODEL="openai/text-embedding-3-small"
# EMBEDDING_DIM=768

# Optional: used only if OPENROUTER_API_KEY is not set (embeddings), or as a
# fallback if an OpenRouter generation call fails.
# GEMINI_API_KEY=""
